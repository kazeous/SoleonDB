# Replacement runtime. Inject real secrets through local .env or Coolify environment.
DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=replace-with-oauth-secret
OWNER_DISCORD_ID=123456789012345678
DASHBOARD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/eousbot
PORT=3000
NODE_ENV=development
# Match the actual reverse proxy network; never trust all incoming addresses.
# Coolify proxy discovery and Secure-cookie troubleshooting: ops/deploy.md.
TRUSTED_PROXY_CIDRS=loopback
DISCORD_ENABLE_MESSAGE_CONTENT=true
DISCORD_ENABLE_PRESENCES=false
# Guild configuration is saved in PostgreSQL through the owner dashboard.
# Optional approved Reddit OAuth application; no anonymous scraping fallback.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Keys alone never enable external summaries. Explicit models and per-channel
# dashboard opt-in are required. Model IDs are deployment choices.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=
